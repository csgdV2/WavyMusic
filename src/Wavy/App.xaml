<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Wavy.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Wavy.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="WavyCardBrush" Color="#1A1A1F" />
                    <SolidColorBrush x:Key="WavySurfaceBrush" Color="#101013" />
                    <SolidColorBrush x:Key="WavyStrokeBrush" Color="#2D2D34" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WavyCardBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="WavySurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WavyStrokeBrush" Color="#E1E1E1" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <conv:DecodedImageConverter x:Key="DecodedImage" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:PercentTooltipConverter x:Key="PercentTooltip" />
            <conv:BoolToAccentBrushConverter x:Key="AccentIfOn" />
            <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="TextControlCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
