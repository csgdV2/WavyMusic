<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wavy.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>

        <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="40" />
        </Style>

        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22,18" />
        </Style>
        <Style x:Key="SettingName" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="MaxWidth" Value="500" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,24,0,8" />
            <Setter Property="FontSize" Value="20" />
        </Style>
    </Page.Resources>

    <Grid Padding="32,24,32,0" RowSpacing="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="20,0,0,0" />

        <ScrollViewer Grid.Row="1" Padding="20,0,20,0" SizeChanged="SettingsScroll_SizeChanged">
            <StackPanel x:Name="SettingsContent" Spacing="10" MaxWidth="1000" HorizontalAlignment="Center" Margin="0,0,0,120">
                <TextBlock Text="Look &amp; feel" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />

                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Theme" Style="{StaticResource SettingName}" />
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="System follows the light/dark setting in Windows. Darker is a deeper, flat black." />
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="140" VerticalAlignment="Center"
                                  SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="System" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="Darker" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Accent color" Style="{StaticResource SettingName}" />
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="Colors the seek bar, selection and highlights. Pick your own or follow Windows." />
                        </StackPanel>
                        <Button Grid.Column="1" MinWidth="0" Padding="10,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="18" Height="18" CornerRadius="9"
                                        Background="{x:Bind ViewModel.AccentBrush, Mode=OneWay}"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.AccentLabel, Mode=OneWay}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="AccentFlyout" Closed="AccentFlyout_Closed">
                                    <StackPanel Spacing="12">
                                        <ColorPicker Color="{x:Bind ViewModel.AccentColor, Mode=TwoWay}"
                                                     IsAlphaEnabled="False"
                                                     IsMoreButtonVisible="False"
                                                     IsColorChannelTextInputVisible="False"
                                                     IsHexInputVisible="True" />
                                        <Button Content="Use Windows accent" HorizontalAlignment="Stretch"
                                                Click="SystemAccent_Click" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Border>

<Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Ambient background" Style="{StaticResource SettingName}" />
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="Tints the page behind your music with a soft blur of the cover art, and fades to the next one as songs change." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                                      OnContent="" OffContent=""
                                      IsOn="{x:Bind ViewModel.AmbientBackground, Mode=TwoWay}" />
                    </Grid>
                </Border>

<TextBlock Text="Find your sound" Style="{StaticResource SectionHeading}" />

                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Get the next song ready early" Style="{StaticResource SettingName}" />
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="Downloads and loads the next song while this one plays, so it starts instantly and runs into it without a gap. Turn off to save data." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                                      OnContent="" OffContent=""
                                      IsOn="{x:Bind ViewModel.PrefetchNext, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Volume steps" Style="{StaticResource SettingName}" />
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="How finely the volume slider moves. Every number changes it by 1%, multiples of 5 snap to 5%." />
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="160" VerticalAlignment="Center"
                                  SelectedIndex="{x:Bind ViewModel.VolumeStepIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Every number" />
                            <ComboBoxItem Content="Multiples of 5" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Normalize audio" Style="{StaticResource SettingName}" />
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="Balances loudness toward −16 LUFS with peak headroom. Preserves dynamics using a lossless copy. Applies on next play." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                                      OnContent="" OffContent=""
                                      IsOn="{x:Bind ViewModel.AudioNormalization, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Song quality" Style="{StaticResource SettingName}" />
                            <TextBlock Text="Best available source is the default. Applies to new streams and downloads; saved songs retain their original quality." Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="180" SelectedIndex="{x:Bind ViewModel.AudioQualityIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Best available" /><ComboBoxItem Content="Balanced (~128 kbps)" /><ComboBoxItem Content="Data saver" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Equalizer" Style="{StaticResource SettingName}" />
                                <TextBlock Style="{StaticResource SettingHint}"
                                           Text="Drag bands up to boost or down to reduce. Changes apply on next play." />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Reset" VerticalAlignment="Center"
                                    Click="ResetEqualizer_Click" />
                        </Grid>

                        <Grid RowSpacing="6" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Height="120">
                                <Canvas x:Name="EqualizerCurve" Height="120" VerticalAlignment="Stretch"
                                        SizeChanged="EqualizerCurve_SizeChanged" IsHitTestVisible="False">
                                    <Line x:Name="EqGrid12" Stroke="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.22" StrokeThickness="0.6" />
                                    <Line x:Name="EqGrid6" Stroke="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.22" StrokeThickness="0.6" />
                                    <Line x:Name="EqGrid0" Stroke="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.45" StrokeThickness="1.2" />
                                    <Line x:Name="EqGridMinus6" Stroke="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.22" StrokeThickness="0.6" />
                                    <Line x:Name="EqGridMinus12" Stroke="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.22" StrokeThickness="0.6" />
                                    <Path x:Name="EqualizerResponse" Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                          StrokeThickness="2.5" StrokeLineJoin="Round" />
                                </Canvas>
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="0"
                                            IsHitTestVisible="False">
                                    <TextBlock Text="+12 dB" FontSize="10" Opacity="0.65" />
                                    <Border Height="31" Opacity="0" />
                                    <TextBlock Text="0 dB" FontSize="10" Opacity="0.65" />
                                    <Border Height="31" Opacity="0" />
                                    <TextBlock Text="−12 dB" FontSize="10" Opacity="0.65" />
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="EqualizerGraph" Grid.Row="1" ColumnSpacing="8" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Slider x:Name="Eq32" Grid.Column="0" Grid.Row="0" Orientation="Vertical" Height="120"
                                    Minimum="-12" Maximum="12" StepFrequency="0.5" Value="0"
                                    VerticalAlignment="Top" HorizontalAlignment="Center"
                                    ValueChanged="Equalizer_ValueChanged"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Grid.Column="0" Grid.Row="1" Text="32 Hz" FontSize="11" Opacity="0.7"
                                       HorizontalAlignment="Center" TextAlignment="Center" />

                            <Slider x:Name="Eq64" Grid.Column="1" Grid.Row="0" Orientation="Vertical" Height="120"
                                    Minimum="-12" Maximum="12" StepFrequency="0.5" Value="0"
                                    VerticalAlignment="Top" HorizontalAlignment="Center"
                                    ValueChanged="Equalizer_ValueChanged"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Grid.Column="1" Grid.Row="1" Text="64 Hz" FontSize="11" Opacity="0.7"
                                       HorizontalAlignment="Center" TextAlignment="Center" />

                            <Slider x:Name="Eq125" Grid.Column="2" Grid.Row="0" Orientation="Vertical" Height="120"
                                    Minimum="-12" Maximum="12" StepFrequency="0.5" Value="0"
                                    VerticalAlignment="Top" HorizontalAlignment="Center"
                                    ValueChanged="Equalizer_ValueChanged"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Grid.Column="2" Grid.Row="1" Text="125 Hz" FontSize="11" Opacity="0.7"
                                       HorizontalAlignment="Center" TextAlignment="Center" />

                            <Slider x:Name="Eq250" Grid.Column="3" Grid.Row="0" Orientation="Vertical" Height="120"
                                    Minimum="-12" Maximum="12" StepFrequency="0.5" Value="0"
                                    VerticalAlignment="Top" HorizontalAlignment="Center"
                                    ValueChanged="Equalizer_ValueChanged"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Grid.Column="3" Grid.Row="1" Text="250 Hz" FontSize="11" Opacity="0.7"
                                       HorizontalAlignment="Center" TextAlignment="Center" />

                            <Slider x:Name="Eq500" Grid.Column="4" Grid.Row="0" Orientation="Vertical" Height="120"
                                    Minimum="-12" Maximum="12" StepFrequency="0.5" Value="0"
                                    VerticalAlignment="Top" HorizontalAlignment="Center"
                                    ValueChanged="Equalizer_ValueChanged"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Grid.Column="4" Grid.Row="1" Text="500 Hz" FontSize="11" Opacity="0.7"
                                       HorizontalAlignment="Center" TextAlignment="Center" />

                            <Slider x:Name="Eq1k" Grid.Column="5" Grid.Row="0" Orientation="Vertical" Height="120"
                                    Minimum="-12" Maximum="12" StepFrequency="0.5" Value="0"
                                    VerticalAlignment="Top" HorizontalAlignment="Center"
                                    ValueChanged="Equalizer_ValueChanged"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Grid.Column="5" Grid.Row="1" Text="1 kHz" FontSize="11" Opacity="0.7"
                                       HorizontalAlignment="Center" TextAlignment="Center" />

                            <Slider x:Name="Eq2k" Grid.Column="6" Grid.Row="0" Orientation="Vertical" Height="120"
                                    Minimum="-12" Maximum="12" StepFrequency="0.5" Value="0"
                                    VerticalAlignment="Top" HorizontalAlignment="Center"
                                    ValueChanged="Equalizer_ValueChanged"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Grid.Column="6" Grid.Row="1" Text="2 kHz" FontSize="11" Opacity="0.7"
                                       HorizontalAlignment="Center" TextAlignment="Center" />

                            <Slider x:Name="Eq4k" Grid.Column="7" Grid.Row="0" Orientation="Vertical" Height="120"
                                    Minimum="-12" Maximum="12" StepFrequency="0.5" Value="0"
                                    VerticalAlignment="Top" HorizontalAlignment="Center"
                                    ValueChanged="Equalizer_ValueChanged"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Grid.Column="7" Grid.Row="1" Text="4 kHz" FontSize="11" Opacity="0.7"
                                       HorizontalAlignment="Center" TextAlignment="Center" />

                            <Slider x:Name="Eq8k" Grid.Column="8" Grid.Row="0" Orientation="Vertical" Height="120"
                                    Minimum="-12" Maximum="12" StepFrequency="0.5" Value="0"
                                    VerticalAlignment="Top" HorizontalAlignment="Center"
                                    ValueChanged="Equalizer_ValueChanged"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Grid.Column="8" Grid.Row="1" Text="8 kHz" FontSize="11" Opacity="0.7"
                                       HorizontalAlignment="Center" TextAlignment="Center" />

                            <Slider x:Name="Eq16k" Grid.Column="9" Grid.Row="0" Orientation="Vertical" Height="120"
                                    Minimum="-12" Maximum="12" StepFrequency="0.5" Value="0"
                                    VerticalAlignment="Top" HorizontalAlignment="Center"
                                    ValueChanged="Equalizer_ValueChanged"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Grid.Column="9" Grid.Row="1" Text="16 kHz" FontSize="11" Opacity="0.7"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Search history" Style="{StaticResource SectionHeading}" />

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Recent searches" Style="{StaticResource SettingName}" />
                                <TextBlock Text="Searches are saved on this device." Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Clear history" VerticalAlignment="Center"
                                    Click="ClearSearchHistory_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Lyrics" Style="{StaticResource SectionHeading}" />

                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Where to get lyrics" Style="{StaticResource SettingName}" />
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="LRCLIB is the open-source, key-free synced lyrics source. Automatic tries exact track matching and searches alternate records before falling back to plain text from Genius or lyrics.ovh." />
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="150" VerticalAlignment="Center"
                                  SelectedIndex="{x:Bind ViewModel.LyricsSourceIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Automatic" />
                            <ComboBoxItem Content="LRCLIB" />
                            <ComboBoxItem Content="lyrics.ovh" />
                            <ComboBoxItem Content="Genius" />
                        </ComboBox>
                    </Grid>
                </Border>

                <TextBlock Text="Discord" Style="{StaticResource SectionHeading}" />

                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Show what you're listening to" Style="{StaticResource SettingName}" />
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="Puts the song, the artist and the cover on your Discord profile while it plays." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                                      OnContent="" OffContent=""
                                      IsOn="{x:Bind ViewModel.DiscordPresence, Mode=TwoWay}" />
                    </Grid>
                </Border>



                <TextBlock Text="Offline songs" Style="{StaticResource SectionHeading}" />

                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Keep unplayed songs for" Style="{StaticResource SettingName}" />
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="Saved songs you haven't played in this long are deleted when the app starts. Songs you keep playing are never touched." />
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="140" VerticalAlignment="Center"
                                  SelectedIndex="{x:Bind ViewModel.KeepIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="A day" />
                            <ComboBoxItem Content="A week" />
                            <ComboBoxItem Content="A month" />
                            <ComboBoxItem Content="Forever" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Saved on this PC" Style="{StaticResource SettingName}" />
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="{x:Bind ViewModel.CacheSummary, Mode=OneWay}" />

                            <TextBlock x:Name="ClearResult" Style="{StaticResource SettingHint}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Clear list" VerticalAlignment="Center"
                                Click="Clear_Click" />
                    </Grid>
                </Border>

                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionHeading}" />

                <Border Style="{StaticResource SettingCard}">

                    <Grid ColumnSpacing="24" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Space" Style="{StaticResource SettingName}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Play or pause" Style="{StaticResource SettingHint}" Margin="0" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + ← / →" Style="{StaticResource SettingName}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Previous or next song" Style="{StaticResource SettingHint}" Margin="0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Shift + ← / →" Style="{StaticResource SettingName}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Skip back or forward 10 seconds" Style="{StaticResource SettingHint}" Margin="0" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl + ↑ / ↓" Style="{StaticResource SettingName}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Volume up or down" Style="{StaticResource SettingHint}" Margin="0" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl + F" Style="{StaticResource SettingName}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Jump to the search box" Style="{StaticResource SettingHint}" Margin="0" />

                    </Grid>
                </Border>

                <TextBlock Text="About" Style="{StaticResource SectionHeading}" />
                <Border x:Name="UpdateCard" Style="{StaticResource SettingCard}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Automatic update checks" Style="{StaticResource SettingName}" />
                                <TextBlock Text="Checks GitHub when Wavy opens, at most twice a day. You choose when to download and install." Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Updates.AutomaticChecks, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{x:Bind Updates.Status, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Updates.DownloadProgress, Mode=OneWay}"
                                     Visibility="{x:Bind Updates.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="{x:Bind Updates.ActionLabel, Mode=OneWay}" IsEnabled="{x:Bind Updates.CanAct, Mode=OneWay}" Click="Update_Click" />
                            <Button Content="Cancel" Click="CancelUpdate_Click" Visibility="{x:Bind Updates.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>


                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Wavy" Style="{StaticResource SettingName}" />
                            <TextBlock Text="{x:Bind ViewModel.Version}" Style="{StaticResource SettingHint}" />
                            <TextBlock Text="{x:Bind ViewModel.Author}" Style="{StaticResource SettingHint}" />
                            <TextBlock Text="{x:Bind ViewModel.DataFolder}" Style="{StaticResource SettingHint}"
                                       IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Open folder" VerticalAlignment="Center"
                                Click="OpenFolder_Click" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
