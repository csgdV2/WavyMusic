<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wavy.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Wavy.Core.Models">

    <Grid x:Name="PageRoot" Padding="24,24,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="SearchHeader" Grid.Row="0" ColumnSpacing="12"
              SizeChanged="SearchHeader_SizeChanged">
            <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="PageTitle" Text="Search" VerticalAlignment="Center"
                       Style="{StaticResource TitleTextBlockStyle}" />

            <AutoSuggestBox Grid.Column="1" x:Name="InlineSearch"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="440" MinWidth="120" MaxWidth="480" MinHeight="36"
                            PlaceholderText="Search"
                            GotFocus="InlineSearch_GotFocus"
                            LostFocus="HistoryFocus_Lost" PreviewKeyDown="Search_KeyDown"
                            TextChanged="InlineSearch_TextChanged"
                            QuerySubmitted="InlineSearch_QuerySubmitted">
                <AutoSuggestBox.Resources>
                    <Thickness x:Key="AutoSuggestBoxDeleteButtonMargin">0</Thickness>
                    <Thickness x:Key="AutoSuggestBoxInnerButtonMargin">0</Thickness>
                    <Thickness x:Key="TextBoxInnerButtonMargin">0</Thickness>
                    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
                    <Thickness x:Key="TextControlThemePadding">12,5</Thickness>
                    <Style TargetType="TextBox"><Setter Property="MinHeight" Value="36" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
                </AutoSuggestBox.Resources>
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
            <Popup x:Name="HistoryPopup" IsLightDismissEnabled="False"
                   HorizontalAlignment="Left" VerticalAlignment="Top">
                <Border x:Name="HistorySurface" Padding="8" CornerRadius="12"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        LostFocus="HistoryFocus_Lost" PreviewKeyDown="Search_KeyDown">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Recent searches" Margin="12,8,12,4" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="HistoryEmptyText" Text="No recent searches" Margin="12,8,12,12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="300" Padding="0">
                            <ItemsControl x:Name="HistoryItems" HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="0" Margin="4,2" Height="44">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Button Click="HistoryQuery_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="8,0"
                                                    AllowFocusOnInteraction="False" AutomationProperties.Name="{Binding}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE81C;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="1" Width="32" Height="32" Padding="0" Margin="0"
                                                    CornerRadius="8" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                                    AllowFocusOnInteraction="False" Click="RemoveSearchHistory_Click"
                                                    AutomationProperties.Name="Remove this recent search" ToolTipService.ToolTip="Remove from history">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <SelectorBar Grid.Row="1" x:Name="Filters" SelectionChanged="Filters_SelectionChanged"
                     Visibility="{x:Bind ViewModel.HasQuery, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <SelectorBarItem Text="Songs" Tag="Songs" IsSelected="True" />
            <SelectorBarItem Text="Videos" Tag="Videos" />
            <SelectorBarItem Text="Artists" Tag="Artists" />
            <SelectorBarItem Text="Albums" Tag="Albums" />
            <SelectorBarItem Text="Playlists" Tag="Playlists" />
        </SelectorBar>

        <Grid Grid.Row="2">
            <Grid RowSpacing="12" Visibility="{x:Bind ViewModel.HasQuery, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="Recently played" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Recent}" SelectionMode="None"
                          IsItemClickEnabled="True" ItemClick="Results_ItemClick" Padding="0,0,20,110">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <Grid Height="60" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="4"><Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=88}" Stretch="UniformToFill" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind SubtitleText}" TextTrimming="CharacterEllipsis" Opacity="0.7" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" VerticalAlignment="Center" Opacity="0.6" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <TextBlock Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.Message, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />

            <ProgressRing Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsHitTestVisible="False"
                          IsActive="{x:Bind ViewModel.ShowBusyIndicator, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.ShowBusyIndicator, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <ListView ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.ShowTracks, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      IsItemClickEnabled="True" ItemClick="Results_ItemClick"
                      SelectionMode="None" Padding="0,0,20,110">
                <ListView.Header>
                    <Button Click="FeaturedArtist_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Padding="24" Margin="0,0,0,20" CornerRadius="16"
                            Background="{ThemeResource WavyRecentBrush}" BorderBrush="{ThemeResource WavyStrokeBrush}"
                            Visibility="{x:Bind ViewModel.ShowFeaturedArtist, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Open matching artist">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="96" Height="96" CornerRadius="48" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                <Image Source="{x:Bind ViewModel.FeaturedArtist.ThumbnailUrl, Mode=OneWay, Converter={StaticResource DecodedImage}, ConverterParameter=192}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="ARTIST" FontSize="11" CharacterSpacing="120" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FeaturedArtist.Name, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.FeaturedArtist.Subtitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Grid Height="60" ColumnSpacing="12" Background="Transparent"
                              PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="4"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                <Image Stretch="UniformToFill"
                                       Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=88}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind SubtitleText}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.6"
                                       Text="{x:Bind DurationText}" Style="{StaticResource CaptionTextBlockStyle}" />
                            <Button x:Name="RowActions" Grid.Column="3" Click="RowActions_Click" Opacity="0"
                                    Width="32" Height="32" Padding="0" CornerRadius="6"
                                    VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="More">
                                <FontIcon Glyph="&#xE712;" FontSize="15" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <GridView ItemsSource="{x:Bind ViewModel.Artists, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.ShowArtists, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      IsItemClickEnabled="True" ItemClick="Artists_ItemClick"
                      SelectionMode="None" Padding="0,0,20,110">
                <GridView.Resources>
                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                </GridView.Resources>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,4,8,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="12" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:ArtistResult">
                        <Grid Background="Transparent"
                              PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
                            <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <StackPanel Width="116" Spacing="8" Margin="8">
                                <Border Width="116" Height="116" CornerRadius="58"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                    <Image Stretch="UniformToFill"
                                           Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=232}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Subtitle}" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <GridView ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.ShowAlbums, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      IsItemClickEnabled="True" ItemClick="Albums_ItemClick"
                      SelectionMode="None" Padding="0,0,20,110">
                <GridView.Resources>
                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                </GridView.Resources>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,4,8,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="12" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:AlbumResult">
                        <Grid Background="Transparent"
                              PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
                            <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <StackPanel Width="152" Spacing="8" Margin="8">
                                <Border Width="152" Height="152" CornerRadius="6"
                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                    <Image Stretch="UniformToFill"
                                           Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=304}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <GridView ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.ShowPlaylists, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      IsItemClickEnabled="True" ItemClick="Playlists_ItemClick"
                      SelectionMode="None" Padding="0,0,20,110">
                <GridView.Resources>
                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                </GridView.Resources>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,4,8,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="12" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlaylistResult">
                        <Grid Background="Transparent"
                              PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
                            <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <StackPanel Width="152" Spacing="8" Margin="8">
                                <Border Width="152" Height="152" CornerRadius="6"
                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                    <Image Stretch="UniformToFill"
                                           Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=304}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
