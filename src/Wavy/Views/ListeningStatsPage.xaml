<Page x:Class="Wavy.Views.ListeningStatsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Wavy.ViewModels">
  <Page.Resources>
    <Style x:Key="RecapRowStyle" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,3" />
      <Setter Property="CornerRadius" Value="10" /><Setter Property="MinHeight" Value="64" />
    </Style>
  </Page.Resources>
  <ScrollViewer Padding="24,20,24,0" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="RecapContent" Spacing="24" Margin="0,0,20,110" SizeChanged="Recap_SizeChanged">
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="5"><TextBlock Text="Recap" FontSize="32" FontWeight="SemiBold" /><TextBlock x:Name="RecapTitle" Opacity="0.65" TextWrapping="Wrap" /></StackPanel>
        <ComboBox Grid.Column="1" x:Name="Period" SelectedIndex="1" SelectionChanged="Period_Changed" Width="142" Height="34" MinHeight="34" VerticalAlignment="Center">
          <ComboBoxItem Content="This month" /><ComboBoxItem Content="This year" /><ComboBoxItem Content="Last year" /><ComboBoxItem Content="All time" />
        </ComboBox>
      </Grid>
      <Border x:Name="EmptyState" Padding="32" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel Spacing="12" MaxWidth="420" HorizontalAlignment="Left">
          <FontIcon Glyph="&#xE9D2;" FontSize="30" HorizontalAlignment="Left" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
          <TextBlock Text="Your music story starts here" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="Listen to a few songs, then come back to see your favorites and time spent listening." TextWrapping="Wrap" Opacity="0.7" />
        </StackPanel>
      </Border>
      <StackPanel x:Name="RecapBody" Spacing="24">
        <Border Padding="24" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="HeroArtColumn" Width="128" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="Time listened" FontSize="14" Opacity="0.7" />
              <TextBlock x:Name="Minutes" FontSize="56" FontWeight="SemiBold" />
              <TextBlock Text="minutes of music" FontSize="16" Opacity="0.7" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="7">
              <Border x:Name="HeroArtBorder" Width="128" Height="128" CornerRadius="12" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                <Grid><FontIcon Glyph="&#xE189;" Opacity="0.4" FontSize="28" /><Image x:Name="HeroArt" Stretch="UniformToFill" /></Grid>
              </Border>
              <TextBlock Text="Top song" FontSize="11" Opacity="0.6" />
              <TextBlock x:Name="TopSongTitle" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
              <HyperlinkButton x:Name="TopSongArtist" Style="{StaticResource ArtistLinkStyle}" Click="Artist_Click" PointerEntered="Artist_PointerEntered" PointerExited="Artist_PointerExited">
                <TextBlock x:Name="TopSongArtistText" FontSize="12" TextTrimming="CharacterEllipsis" />
              </HyperlinkButton>
            </StackPanel>
          </Grid>
        </Border>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="4"><TextBlock x:Name="Plays" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="Plays" FontSize="12" Opacity="0.65" /></StackPanel></Border>
          <Border Grid.Column="1" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="4"><TextBlock x:Name="SongCount" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="Songs" FontSize="12" Opacity="0.65" /></StackPanel></Border>
          <Border Grid.Column="2" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="4"><TextBlock x:Name="ArtistCount" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="Artists" FontSize="12" Opacity="0.65" /></StackPanel></Border>
        </Grid>
        <Grid x:Name="Rankings" ColumnSpacing="24" RowSpacing="24">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="ArtistColumn" Width="0" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Spacing="10">
            <TextBlock Text="Top songs" FontSize="22" FontWeight="SemiBold" />
            <ListView x:Name="TopSongs" ItemContainerStyle="{StaticResource RecapRowStyle}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Song_Click" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListView.ItemTemplate><DataTemplate x:DataType="vm:RecapSongRow">
                <Grid Padding="8" ColumnSpacing="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind Rank}" Opacity="0.5" VerticalAlignment="Center" FontSize="13" />
                  <Border Grid.Column="1" Width="44" Height="44" CornerRadius="6" Background="{ThemeResource ControlAltFillColorSecondaryBrush}"><Image Stretch="UniformToFill" Source="{x:Bind Track.ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=96}" /></Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{x:Bind Track.Title}" FontSize="14" TextTrimming="CharacterEllipsis" /><HyperlinkButton Style="{StaticResource ArtistLinkStyle}" DataContext="{x:Bind Track}" Click="Artist_Click" PointerEntered="Artist_PointerEntered" PointerExited="Artist_PointerExited"><TextBlock Text="{x:Bind Track.Artist}" FontSize="12" TextTrimming="CharacterEllipsis" /></HyperlinkButton></StackPanel>
                  <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{x:Bind PlaysText}" FontSize="12" HorizontalAlignment="Right" /><TextBlock Text="{x:Bind TimeText}" FontSize="11" Opacity="0.55" HorizontalAlignment="Right" /></StackPanel>
                </Grid>
              </DataTemplate></ListView.ItemTemplate>
            </ListView>
          </StackPanel>
          <StackPanel x:Name="ArtistsSection" Grid.Row="1" Spacing="10">
            <TextBlock Text="Top artists" FontSize="22" FontWeight="SemiBold" />
            <ListView x:Name="TopArtists" ItemContainerStyle="{StaticResource RecapRowStyle}" SelectionMode="None" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListView.ItemTemplate><DataTemplate x:DataType="vm:RecapArtistRow">
                <Grid Padding="8,10" ColumnSpacing="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind Rank}" Opacity="0.5" FontSize="13" VerticalAlignment="Center" />
                  <HyperlinkButton Grid.Column="1" Style="{StaticResource ArtistLinkStyle}" Click="Artist_Click" DataContext="{x:Bind}">
                    <Border Width="44" Height="44" CornerRadius="22" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                      <Grid><FontIcon Glyph="&#xE77B;" FontSize="20" Opacity="0.4" /><Image Stretch="UniformToFill" Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=96}" /></Grid>
                    </Border>
                  </HyperlinkButton>
                  <HyperlinkButton Grid.Column="2" Style="{StaticResource ArtistLinkStyle}" VerticalAlignment="Center" Click="Artist_Click" DataContext="{x:Bind}" PointerEntered="Artist_PointerEntered" PointerExited="Artist_PointerExited"><TextBlock Text="{x:Bind Name}" FontSize="14" TextTrimming="CharacterEllipsis" /></HyperlinkButton>
                  <TextBlock Grid.Column="3" Text="{x:Bind Detail}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate></ListView.ItemTemplate>
            </ListView>
          </StackPanel>
        </Grid>
      </StackPanel>
      <InfoBar x:Name="ArtistMessage" IsOpen="False" Severity="Informational" Title="Artist" />
      <TextBlock x:Name="Since" FontSize="12" Opacity="0.5" TextWrapping="Wrap" ToolTipService.ToolTip="A play counts after 30 seconds, or half of a shorter song. Pauses and seeking do not add listening time." />
    </StackPanel>
  </ScrollViewer>
</Page>
