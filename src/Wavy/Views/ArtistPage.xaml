<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wavy.Views.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Wavy.Core.Models">

    <Grid>
        <TextBlock Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                   Visibility="{x:Bind ViewModel.Message, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />

        <ProgressRing Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer Padding="24,16,32,0"
                      Visibility="{x:Bind ViewModel.IsLoaded, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Spacing="20" Margin="0,0,0,110">

                <Grid MinHeight="280" CornerRadius="18" Background="#202020" RequestedTheme="Dark">
                    <Image Stretch="UniformToFill" Opacity="0.65"
                           Source="{x:Bind ViewModel.Artist.BannerUrl, Mode=OneWay, Converter={StaticResource DecodedImage}, ConverterParameter=1080}" />
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#66000000" />
                                <GradientStop Offset="1" Color="#EE000000" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Padding="32" VerticalAlignment="Bottom">
                        <StackPanel Spacing="10">
                            <TextBlock Text="ARTIST" FontSize="11" CharacterSpacing="160" Foreground="#D9FFFFFF" />
                            <TextBlock Text="{x:Bind ViewModel.Artist.Name, Mode=OneWay}" Foreground="White" FontSize="42" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.Artist.Subtitle, Mode=OneWay}" Foreground="#D9FFFFFF" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0"
                                        Visibility="{x:Bind ViewModel.Artist.HasTopSongs, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Button Click="Play_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="20" Padding="22,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontSize="14" Glyph="&#xF5B0;" /><TextBlock Text="Play" /></StackPanel>
                                </Button>
                                <Button Click="Shuffle_Click" CornerRadius="20" Padding="22,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontSize="14" Glyph="&#xE8B1;" /><TextBlock Text="Shuffle" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.Artist.HasTopSongs, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Top songs" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ListView ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
                              IsItemClickEnabled="True" ItemClick="Songs_ItemClick"
                              SelectionMode="None" Padding="0,0,20,0"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Grid Height="64" ColumnSpacing="12" Background="Transparent" PointerEntered="Song_PointerEntered" PointerExited="Song_PointerExited">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                        <Image Stretch="UniformToFill"
                                               Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=80}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind SubtitleText}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.6"
                                               Text="{x:Bind DurationText}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Button x:Name="RowActions" Grid.Column="3" Opacity="0" Click="SongActions_Click" Width="32" Height="32" Padding="0" CornerRadius="8"
                                            Background="Transparent" BorderThickness="0" VerticalAlignment="Center" AutomationProperties.Name="Song options">
                                        <FontIcon Glyph="&#xE712;" FontSize="15" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <HyperlinkButton Content="Show more" Click="ShowMore_Click"
                                     HorizontalAlignment="Left" Margin="0,2,0,0"
                                     Visibility="{x:Bind ViewModel.CanShowMoreSongs, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.Artist.HasReleases, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

                    <TextBlock Text="Albums &amp; singles" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <GridView ItemsSource="{x:Bind ViewModel.Artist.Releases, Mode=OneWay}"
                              IsItemClickEnabled="True" ItemClick="Releases_ItemClick"
                              SelectionMode="None" Padding="0,0,20,0"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <GridView.Resources>
                            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                        </GridView.Resources>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,4,8,12" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="CornerRadius" Value="12" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:AlbumResult">
                                <Grid Background="Transparent"
                                      PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
                                    <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                            Background="{ThemeResource WavyHoverBrush}" />
                                    <StackPanel Width="152" Spacing="8" Margin="8">
                                        <Border Width="152" Height="152" CornerRadius="6"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                            <Image Stretch="UniformToFill"
                                                   Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=304}" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.Artist.Description, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border CornerRadius="16" Padding="24" Background="{ThemeResource WavyRecentBrush}" BorderBrush="{ThemeResource WavyStrokeBrush}" BorderThickness="1">
                        <TextBlock Text="{x:Bind ViewModel.Artist.Description, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="760"
                                   HorizontalAlignment="Left" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="24" />
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.HasSimilar, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Fans might also like" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <GridView ItemsSource="{x:Bind ViewModel.Artist.Similar, Mode=OneWay}"
                              IsItemClickEnabled="True" ItemClick="Similar_ItemClick"
                              SelectionMode="None" Padding="0,0,20,0"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <GridView.Resources>
                            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                        </GridView.Resources>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,4,8,12" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="CornerRadius" Value="12" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:ArtistResult">
                                <Grid Background="Transparent"
                                      PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
                                    <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                            Background="{ThemeResource WavyHoverBrush}" />
                                    <StackPanel Width="116" Spacing="8" Margin="8">
                                        <Border Width="116" Height="116" CornerRadius="58"
                                                HorizontalAlignment="Center"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                            <Image Stretch="UniformToFill"
                                                   Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=232}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Name}" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
