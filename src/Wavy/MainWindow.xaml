<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Wavy.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Wavy.Controls">
  <Grid x:Name="RootGrid">
<Grid x:Name="Ambient" IsHitTestVisible="False" Visibility="Collapsed">
      <Grid x:Name="AmbientBack" Opacity="0" />
      <Grid x:Name="AmbientFront" Opacity="0" />
      <Rectangle x:Name="AmbientScrim" Opacity="0.28" />
    </Grid>
    <NavigationView x:Name="Nav" PaneDisplayMode="LeftCompact" IsPaneOpen="False" CompactPaneLength="48" OpenPaneLength="48" CompactModeThresholdWidth="0" IsPaneToggleButtonVisible="False" IsBackButtonVisible="Visible" IsBackEnabled="False" IsSettingsVisible="True" BackRequested="Nav_BackRequested" SelectionChanged="Nav_SelectionChanged" ItemInvoked="Nav_ItemInvoked">
      <NavigationView.Resources>
        <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource TextFillColorPrimary}" />
        <x:Double x:Key="NavigationViewItemOnLeftMinHeight">40</x:Double>
        <CornerRadius x:Key="NavigationViewItemCornerRadius">10</CornerRadius>
        <Thickness x:Key="NavigationViewItemButtonMargin">0</Thickness>
        <Style TargetType="NavigationViewItem">
          <Setter Property="Width" Value="40" />
          <Setter Property="Height" Value="40" />
          <Setter Property="MinHeight" Value="40" />
          <Setter Property="Margin" Value="4,3" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>
      </NavigationView.Resources>
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="SearchNavItem" Content="Search" Tag="search">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="HomeNavItem" Content="Home" Tag="home" IsSelected="True">
          <NavigationViewItem.Icon>
            <FontIcon x:Name="HomeIcon" Glyph="" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="PlaylistsNavItem" Content="Playlists" Tag="playlists">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="AlbumsNavItem" Content="Albums" Tag="albums">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="RecapNavItem" Content="Recap" Tag="recap" ToolTipService.ToolTip="Recap">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <Grid RowSpacing="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="ContentArea" Grid.Row="1" ColumnSpacing="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0">
            <Frame x:Name="ContentFrame" />
            <InfoBar VerticalAlignment="Bottom" Margin="16,16,16,104" Canvas.ZIndex="4" Severity="Error" Title="Playback" IsOpen="{x:Bind Player.HasStatusMessage, Mode=OneWay}" Message="{x:Bind Player.StatusMessage, Mode=OneWay}" CloseButtonClick="Status_CloseButtonClick" />
          </Grid>
          <controls:LyricsPanel x:Name="LyricsSide" Grid.Column="1" Canvas.ZIndex="1" />
          <controls:QueuePanel x:Name="QueueSide" Grid.Column="2" Canvas.ZIndex="1" />
        </Grid>
        <controls:NowPlayingBar x:Name="NowPlaying" Grid.Row="1" Canvas.ZIndex="2" />
        <Grid x:Name="TitleStrip" Grid.Row="1" Height="48" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="Transparent" Canvas.ZIndex="3" />
      </Grid>
    </NavigationView>
    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="360" Margin="16,64,20,0" Padding="18" CornerRadius="14"
            Canvas.ZIndex="10" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
            Visibility="{x:Bind Updates.NotificationVisibility, Mode=OneWay}"
            AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Wavy update available">
      <StackPanel Spacing="10">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="Update available" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="8"
                  Background="Transparent" BorderThickness="0" Click="Update_Dismiss" ToolTipService.ToolTip="Dismiss"
                  AutomationProperties.Name="Dismiss update notification">
            <FontIcon Glyph="&#xE711;" FontSize="12" />
          </Button>
        </Grid>
        <TextBlock Text="{x:Bind Updates.Status, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Button Content="View update" HorizontalAlignment="Left" Click="Update_OpenSettings" />
      </StackPanel>
    </Border>
  </Grid>
</Window>