<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MusicApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:MusicApp.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <conv:DecodedImageConverter x:Key="DecodedImage" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:PercentTooltipConverter x:Key="PercentTooltip" />
            <conv:BoolToAccentBrushConverter x:Key="AccentIfOn" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
