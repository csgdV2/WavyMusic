<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="MusicApp.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MusicApp.Core.Models">

    <Grid Padding="24,16,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="History" Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" />
            <Button x:ConnectionId='10' Content="Clear list"
                                                                    
                    HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock x:ConnectionId='2' Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                       Text="Nothing played yet. Songs you play show up here."
                                                                                                                         />

            <ListView x:ConnectionId='3'                                                     
                      IsItemClickEnabled="True"                             
                      SelectionMode="None" Padding="0,0,0,110"
                                                                                                                                                  >
                <ListView.ItemTemplate>
                    <DataTemplate                          >
                        <Grid x:ConnectionId='5' Height="60" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="4"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                <Image x:ConnectionId='9' Stretch="UniformToFill"
                                                                                                                                      />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:ConnectionId='7'                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:ConnectionId='8'                        TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock x:ConnectionId='6' Grid.Column="2" VerticalAlignment="Center" Opacity="0.6"
                                                                    Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>

