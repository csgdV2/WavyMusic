<?xml version="1.0" encoding="utf-8"?>
<Window x:ConnectionId='1'
    x:Class="MusicApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicApp.Controls">

    <Grid x:ConnectionId='2' x:Name="RootGrid">

        <Grid x:ConnectionId='3' x:Name="Ambient" IsHitTestVisible="False" Visibility="Collapsed">
            <Grid x:ConnectionId='17' x:Name="AmbientBack" Opacity="0" />
            <Grid x:ConnectionId='18' x:Name="AmbientFront" Opacity="0" />
            <Rectangle x:ConnectionId='19' x:Name="AmbientScrim" Opacity="0.28" />
        </Grid>

        <NavigationView x:ConnectionId='4' x:Name="Nav"
                        PaneDisplayMode="Auto"
                        CompactModeThresholdWidth="0"
                        IsBackButtonVisible="Visible"
                        IsBackEnabled="False"
                        IsSettingsVisible="True"
                                                         
                                                                   
                                                   
                                                   
                                                               
                                                     >
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:ConnectionId='6' x:Name="SearchSuggest"
                                PlaceholderText="Search"
                                                                       
                                                                             >
                    <AutoSuggestBox.QueryIcon>
                        <SymbolIcon Symbol="Find" />
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEA8A;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:ConnectionId='7' x:Name="SearchNavItem" Content="Search" Tag="search">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:ConnectionId='8' x:Name="PlaylistsNavItem" Content="Playlists" Tag="playlists">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE90B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:ConnectionId='9' x:Name="AlbumsNavItem" Content="Albums" Tag="albums">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE93C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="History" Tag="history">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:ConnectionId='10' x:Name="ContentArea" Grid.Row="1" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Frame x:ConnectionId='15' x:Name="ContentFrame" />

                        <InfoBar x:ConnectionId='16' VerticalAlignment="Bottom" Margin="16"
                                 Severity="Error"
                                 Title="Playback"
                                                                                       
                                                                                     
                                                                            />
                    </Grid>

                    <controls:LyricsPanel x:ConnectionId='13' x:Name="LyricsSide" Grid.Column="1" />

                    <controls:QueuePanel x:ConnectionId='14' x:Name="QueueSide" Grid.Column="2" />
                </Grid>

                <controls:NowPlayingBar x:ConnectionId='11' x:Name="NowPlaying" Grid.Row="0" />

                <Grid x:ConnectionId='12' x:Name="TitleStrip" Grid.Row="0" Height="48"
                      VerticalAlignment="Top" HorizontalAlignment="Stretch"
                      Background="Transparent" Visibility="Collapsed" />
            </Grid>
        </NavigationView>

        <StackPanel x:ConnectionId='5' x:Name="Brand"
                    Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    IsHitTestVisible="False" Visibility="Collapsed">
            <Image Width="20" Height="20" VerticalAlignment="Center"
                   Source="ms-appx:///Assets/app.png" />
            <TextBlock Text="Wavy" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>

