<?xml version="1.0" encoding="utf-8"?>
<UserControl x:ConnectionId='1'
    x:Class="MusicApp.Controls.QueuePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MusicApp.Core.Models">

    <Grid x:ConnectionId='2' x:Name="Root" Width="320" RowSpacing="8" Padding="12,12,12,0"
          CornerRadius="12,0,0,0"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderThickness="1,0,0,0"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                                                               >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Queue" VerticalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}" />

            <Button x:ConnectionId='12' Grid.Column="1"                                                   
                    Width="32" Height="32" Padding="0" CornerRadius="6"
                    Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Keep playing similar songs">
                <TextBlock x:ConnectionId='15' Text="&#x221E;" FontSize="18" FontWeight="SemiBold"
                                                                                    
                                                                                                                            />
            </Button>

            <Button x:ConnectionId='13' Grid.Column="2"                                               
                    Width="32" Height="32" Padding="0" CornerRadius="6"
                    Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Clear what's next">
                <FontIcon Glyph="&#xE74D;" FontSize="14" />
            </Button>

            <Button x:ConnectionId='14' Grid.Column="3"                                                
                    Width="32" Height="32" Padding="0" CornerRadius="6"
                    Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Close">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>

        <TextBlock x:ConnectionId='3' Grid.Row="1" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="220"
                   Text="Nothing lined up yet. Play a song and what comes next shows up here."
                                                                                                                                                 />

        <ListView x:ConnectionId='4' Grid.Row="1" x:Name="QueueList"
                                                        
                                                                              
                  SelectionMode="Single" IsItemClickEnabled="True"                            
                  CanReorderItems="True" CanDragItems="True" AllowDrop="True" ReorderMode="Enabled"
                  Padding="0,0,0,12">
            <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
            </ListView.Resources>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="8,2,8,2" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate                          >
                    <Grid x:ConnectionId='6' Height="52" Background="Transparent"
                                                                                               >
                        <Border x:Name="HoverPlate" Opacity="0" CornerRadius="8" Margin="-6,1,-6,1"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                <Image x:ConnectionId='11' Stretch="UniformToFill"
                                                                                                                                      />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:ConnectionId='9'                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:ConnectionId='10'                              TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>

                            <Button x:ConnectionId='8' x:Name="RowActions" Grid.Column="0"                      Opacity="0"
                                    Width="20" Height="20" Padding="0" CornerRadius="10"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,1,0,0"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="Remove from queue">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground" Color="#D13438" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#8B1A1E" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B1316" />
                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                </Button.Resources>
                                <FontIcon Glyph="&#xE738;" FontSize="11" Foreground="White" />
                            </Button>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>

