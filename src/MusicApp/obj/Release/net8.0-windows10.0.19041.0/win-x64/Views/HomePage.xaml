<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="MusicApp.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicApp.Controls"
    xmlns:models="using:MusicApp.Core.Models">

    <Page.Resources>
        <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
        <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
        <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />

        <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="1" />
        </Style>

        <Style x:Key="TileContainer" TargetType="GridViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="24,16,24,0">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch" Margin="0,0,0,110">

            <StackPanel Spacing="2">
                <TextBlock x:ConnectionId='79'                                                
                           Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:ConnectionId='80' Opacity="0.7" Style="{StaticResource BodyTextBlockStyle}"
                           Text="Everything you've been listening to, and what to play next."
                                                                                                                                                        />
            </StackPanel>

            <Border x:ConnectionId='2' CornerRadius="12" Padding="24" MaxWidth="560" HorizontalAlignment="Left"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                                                                                                                     >
                <StackPanel Spacing="12">
                    <TextBlock Text="Nothing here yet" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="Search for a song to start it playing. What you play collects here, alongside any playlists you make and albums you keep." />
                    <Button x:ConnectionId='78' Content="Search" Tag="search"                     
                            HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <StackPanel x:ConnectionId='3' Spacing="10"
                                                                                                                           >
                <Grid>
                    <TextBlock Text="Recently played" Style="{StaticResource SectionHeading}" />
                    <HyperlinkButton x:ConnectionId='77' Content="See all" Tag="history"                     
                                     HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <GridView x:ConnectionId='68'                                                     
                          IsItemClickEnabled="True" SelectionMode="None"
                                                      
                          ItemContainerStyle="{StaticResource TileContainer}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <GridView.ItemTemplate>
                        <DataTemplate                          >
                            <Grid x:ConnectionId='70' Background="Transparent"
                                                                                                                   >
                                <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <StackPanel Width="152" Spacing="8" Margin="8">
                                    <Grid>
                                        <Border Width="152" Height="152" CornerRadius="6"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                            <Image x:ConnectionId='76' Stretch="UniformToFill"
                                                                                                                                                   />
                                        </Border>

                                        <Button x:ConnectionId='75' x:Name="RowActions"                          Opacity="0"
                                                Width="32" Height="32" Padding="0" CornerRadius="6"
                                                Margin="0,4,4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="More">
                                            <FontIcon Glyph="&#xE712;" FontSize="15" />
                                        </Button>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock x:ConnectionId='72'                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <HyperlinkButton x:ConnectionId='73'                                            
                                                         Padding="0" Margin="0" MinWidth="0" MinHeight="0"
                                                         Background="Transparent" BorderThickness="0"
                                                         HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                                                                               
                                                                                             >
                                            <TextBlock x:ConnectionId='74' x:Name="ArtistText"                       
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </HyperlinkButton>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <StackPanel x:ConnectionId='4' Spacing="10"
                                                                                                                              >
                <Grid>
                    <TextBlock Text="Your playlists" Style="{StaticResource SectionHeading}" />
                    <HyperlinkButton x:ConnectionId='67' Content="See all" Tag="playlists"                     
                                     HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <GridView x:ConnectionId='60'                                                        
                          IsItemClickEnabled="True" SelectionMode="None"
                                                        
                          ItemContainerStyle="{StaticResource TileContainer}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <GridView.ItemTemplate>
                        <DataTemplate                             >
                            <Grid x:ConnectionId='62' Background="Transparent"
                                                                                                                             >
                                <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <StackPanel Width="152" Spacing="8" Margin="8">
                                    <Grid>
                                        <controls:PlaylistCover x:ConnectionId='65'                     Size="152" Radius="6" />
                                        <Button x:ConnectionId='66' x:Name="RowActions" Opacity="0"
                                                                                                 
                                                Width="36" Height="36" Padding="0" CornerRadius="18"
                                                Margin="0,0,8,8"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Style="{StaticResource AccentButtonStyle}"
                                                ToolTipService.ToolTip="Play">
                                            <FontIcon Glyph="&#xF5B0;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                    <TextBlock x:ConnectionId='64'                      TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <StackPanel x:ConnectionId='5' Spacing="10"
                                                                                                                           >
                <Grid>
                    <TextBlock Text="Albums you kept" Style="{StaticResource SectionHeading}" />
                    <HyperlinkButton x:ConnectionId='59' Content="See all" Tag="albums"                     
                                     HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <GridView x:ConnectionId='51'                                                     
                          IsItemClickEnabled="True" SelectionMode="None"
                                                     
                          ItemContainerStyle="{StaticResource TileContainer}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <GridView.ItemTemplate>
                        <DataTemplate                                >
                            <Grid x:ConnectionId='53' Background="Transparent"
                                                                                                                             >
                                <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <StackPanel Width="152" Spacing="8" Margin="8">
                                    <Grid>
                                        <Border Width="152" Height="152" CornerRadius="6"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                            <Image x:ConnectionId='58' Stretch="UniformToFill"
                                                                                                                                                   />
                                        </Border>
                                        <Button x:ConnectionId='57' x:Name="RowActions" Opacity="0"
                                                                                              
                                                Width="36" Height="36" Padding="0" CornerRadius="18"
                                                Margin="0,0,8,8"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Style="{StaticResource AccentButtonStyle}"
                                                ToolTipService.ToolTip="Play">
                                            <FontIcon Glyph="&#xF5B0;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock x:ConnectionId='55'                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:ConnectionId='56'                          TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <StackPanel x:ConnectionId='6' Spacing="10"
                                                                                                                        >
                <Grid>
                    <TextBlock Text="From your playlists" Style="{StaticResource SectionHeading}" />
                    <HyperlinkButton x:ConnectionId='50' Content="See all" Tag="playlists"                     
                                     HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <GridView x:ConnectionId='41'                                                  
                          IsItemClickEnabled="True" SelectionMode="None"
                                                   
                          ItemContainerStyle="{StaticResource TileContainer}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <GridView.ItemTemplate>
                        <DataTemplate                          >
                            <Grid x:ConnectionId='43' Background="Transparent"
                                                                                                                   >
                                <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <StackPanel Width="152" Spacing="8" Margin="8">
                                    <Grid>
                                        <Border Width="152" Height="152" CornerRadius="6"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                            <Image x:ConnectionId='49' Stretch="UniformToFill"
                                                                                                                                                   />
                                        </Border>
                                        <Button x:ConnectionId='48' x:Name="RowActions"                          Opacity="0"
                                                Width="32" Height="32" Padding="0" CornerRadius="6"
                                                Margin="0,4,4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="More">
                                            <FontIcon Glyph="&#xE712;" FontSize="15" />
                                        </Button>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock x:ConnectionId='45'                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <HyperlinkButton x:ConnectionId='46'                                            
                                                         Padding="0" Margin="0" MinWidth="0" MinHeight="0"
                                                         Background="Transparent" BorderThickness="0"
                                                         HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                                                                               
                                                                                             >
                                            <TextBlock x:ConnectionId='47' x:Name="ArtistText"                       
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </HyperlinkButton>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <StackPanel x:ConnectionId='7' Spacing="10"
                                                                                                                                 >
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock x:ConnectionId='39'                                                          
                               Style="{StaticResource SectionHeading}" MaxWidth="520" />
                    <ProgressRing x:ConnectionId='40' Width="16" Height="16" VerticalAlignment="Center"
                                                                                                  />
                </StackPanel>
                <GridView x:ConnectionId='30'                                                          
                          IsItemClickEnabled="True" SelectionMode="None"
                                                          
                          ItemContainerStyle="{StaticResource TileContainer}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <GridView.ItemTemplate>
                        <DataTemplate                          >
                            <Grid x:ConnectionId='32' Background="Transparent"
                                                                                                                   >
                                <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <StackPanel Width="152" Spacing="8" Margin="8">
                                    <Grid>
                                        <Border Width="152" Height="152" CornerRadius="6"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                            <Image x:ConnectionId='38' Stretch="UniformToFill"
                                                                                                                                                   />
                                        </Border>
                                        <Button x:ConnectionId='37' x:Name="RowActions"                          Opacity="0"
                                                Width="32" Height="32" Padding="0" CornerRadius="6"
                                                Margin="0,4,4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="More">
                                            <FontIcon Glyph="&#xE712;" FontSize="15" />
                                        </Button>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock x:ConnectionId='34'                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <HyperlinkButton x:ConnectionId='35'                                            
                                                         Padding="0" Margin="0" MinWidth="0" MinHeight="0"
                                                         Background="Transparent" BorderThickness="0"
                                                         HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                                                                               
                                                                                             >
                                            <TextBlock x:ConnectionId='36' x:Name="ArtistText"                       
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </HyperlinkButton>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <StackPanel x:ConnectionId='8' Spacing="10"
                                                                                                                             >
                <TextBlock x:ConnectionId='20'                                                        Style="{StaticResource SectionHeading}" />
                <GridView x:ConnectionId='21'                                                       
                          IsItemClickEnabled="True" SelectionMode="None"
                                                        
                          ItemContainerStyle="{StaticResource TileContainer}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <GridView.ItemTemplate>
                        <DataTemplate                          >
                            <Grid x:ConnectionId='23' Background="Transparent"
                                                                                                                   >
                                <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <StackPanel Width="152" Spacing="8" Margin="8">
                                    <Grid>
                                        <Border Width="152" Height="152" CornerRadius="6"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                            <Image x:ConnectionId='29' Stretch="UniformToFill"
                                                                                                                                                   />
                                        </Border>
                                        <Button x:ConnectionId='28' x:Name="RowActions"                          Opacity="0"
                                                Width="32" Height="32" Padding="0" CornerRadius="6"
                                                Margin="0,4,4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="More">
                                            <FontIcon Glyph="&#xE712;" FontSize="15" />
                                        </Button>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock x:ConnectionId='25'                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <HyperlinkButton x:ConnectionId='26'                                            
                                                         Padding="0" Margin="0" MinWidth="0" MinHeight="0"
                                                         Background="Transparent" BorderThickness="0"
                                                         HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                                                                               
                                                                                             >
                                            <TextBlock x:ConnectionId='27' x:Name="ArtistText"                       
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </HyperlinkButton>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
            <StackPanel x:ConnectionId='9' Spacing="10"
                                                                                                                          >
                <TextBlock x:ConnectionId='10'                                                     Style="{StaticResource SectionHeading}" />
                <GridView x:ConnectionId='11'                                                    
                          IsItemClickEnabled="True" SelectionMode="None"
                                                     
                          ItemContainerStyle="{StaticResource TileContainer}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <GridView.ItemTemplate>
                        <DataTemplate                          >
                            <Grid x:ConnectionId='13' Background="Transparent"
                                                                                                                   >
                                <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <StackPanel Width="152" Spacing="8" Margin="8">
                                    <Grid>
                                        <Border Width="152" Height="152" CornerRadius="6"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                            <Image x:ConnectionId='19' Stretch="UniformToFill"
                                                                                                                                                   />
                                        </Border>
                                        <Button x:ConnectionId='18' x:Name="RowActions"                          Opacity="0"
                                                Width="32" Height="32" Padding="0" CornerRadius="6"
                                                Margin="0,4,4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="More">
                                            <FontIcon Glyph="&#xE712;" FontSize="15" />
                                        </Button>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock x:ConnectionId='15'                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <HyperlinkButton x:ConnectionId='16'                                            
                                                         Padding="0" Margin="0" MinWidth="0" MinHeight="0"
                                                         Background="Transparent" BorderThickness="0"
                                                         HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                                                                               
                                                                                             >
                                            <TextBlock x:ConnectionId='17' x:Name="ArtistText"                       
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </HyperlinkButton>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

