<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="MusicApp.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MusicApp.Core.Models">

    <Grid Padding="24,16,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:ConnectionId='34' Grid.Column="0" x:Name="PageTitle" Text="Search" VerticalAlignment="Center"
                       Style="{StaticResource TitleTextBlockStyle}" />

            <AutoSuggestBox x:ConnectionId='35' Grid.Column="1" x:Name="InlineSearch"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="320" Visibility="Collapsed"
                            PlaceholderText="Search"
                                                                  
                                                                        >
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
        </Grid>

        <SelectorBar x:ConnectionId='2' Grid.Row="1" x:Name="Filters"                                            
                                                                                                                       >
            <SelectorBarItem Text="Songs" Tag="Songs" IsSelected="True" />
            <SelectorBarItem Text="Videos" Tag="Videos" />
            <SelectorBarItem Text="Artists" Tag="Artists" />
            <SelectorBarItem Text="Albums" Tag="Albums" />
            <SelectorBarItem Text="Playlists" Tag="Playlists" />
        </SelectorBar>

        <Grid Grid.Row="2">
            <TextBlock x:ConnectionId='3' Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                     
                                                                                                                           />

            <ProgressRing x:ConnectionId='4' Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsHitTestVisible="False"
                                                                                      
                                                                                                                                      />

            <ListView x:ConnectionId='5'                                                      
                                                                                                                          
                      IsItemClickEnabled="True"                              
                      SelectionMode="None" Padding="0,0,0,110">
                <ListView.ItemTemplate>
                    <DataTemplate                          >
                        <Grid x:ConnectionId='28' Height="60" ColumnSpacing="12" Background="Transparent"
                                                                                                   >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="4"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                <Image x:ConnectionId='33' Stretch="UniformToFill"
                                                                                                                                      />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:ConnectionId='31'                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:ConnectionId='32'                              TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock x:ConnectionId='29' Grid.Column="2" VerticalAlignment="Center" Opacity="0.6"
                                                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            <Button x:ConnectionId='30' x:Name="RowActions" Grid.Column="3"                          Opacity="0"
                                    Width="32" Height="32" Padding="0" CornerRadius="6"
                                    VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="More">
                                <FontIcon Glyph="&#xE712;" FontSize="15" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <GridView x:ConnectionId='6'                                                      
                                                                                                                           
                      IsItemClickEnabled="True"                              
                      SelectionMode="None" Padding="0,0,0,110">
                <GridView.Resources>
                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                </GridView.Resources>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,4,8,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="12" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate                                 >
                        <Grid x:ConnectionId='22' Background="Transparent"
                                                                                                     >
                            <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <StackPanel Width="116" Spacing="8" Margin="8">
                                <Border Width="116" Height="116" CornerRadius="58"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                    <Image x:ConnectionId='26' Stretch="UniformToFill"
                                                                                                                                           />
                                </Border>
                                <StackPanel>
                                    <TextBlock x:ConnectionId='24'                      TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:ConnectionId='25'                          TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <GridView x:ConnectionId='7'                                                     
                                                                                                                          
                      IsItemClickEnabled="True"                             
                      SelectionMode="None" Padding="0,0,0,110">
                <GridView.Resources>
                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                </GridView.Resources>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,4,8,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="12" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate                                >
                        <Grid x:ConnectionId='16' Background="Transparent"
                                                                                                     >
                            <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <StackPanel Width="152" Spacing="8" Margin="8">
                                <Border Width="152" Height="152" CornerRadius="6"
                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                    <Image x:ConnectionId='20' Stretch="UniformToFill"
                                                                                                                                           />
                                </Border>
                                <StackPanel>
                                    <TextBlock x:ConnectionId='18'                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:ConnectionId='19'                          TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <GridView x:ConnectionId='8'                                                        
                                                                                                                             
                      IsItemClickEnabled="True"                                
                      SelectionMode="None" Padding="0,0,0,110">
                <GridView.Resources>
                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                </GridView.Resources>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,4,8,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="12" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate                                   >
                        <Grid x:ConnectionId='10' Background="Transparent"
                                                                                                     >
                            <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <StackPanel Width="152" Spacing="8" Margin="8">
                                <Border Width="152" Height="152" CornerRadius="6"
                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                    <Image x:ConnectionId='14' Stretch="UniformToFill"
                                                                                                                                           />
                                </Border>
                                <StackPanel>
                                    <TextBlock x:ConnectionId='12'                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:ConnectionId='13'                          TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>

