<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="MusicApp.Views.AlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MusicApp.Core.Models">

    <Grid Padding="24,16,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Albums" Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1">
            <TextBlock x:ConnectionId='2' Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380"
                       Text="No albums kept yet. Open an album and press Favourite to keep it here."
                                                                                                                         />

            <GridView x:ConnectionId='3'                                                     
                      IsItemClickEnabled="True"                             
                      SelectionMode="None" Padding="0,0,0,110">
                <GridView.Resources>
                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                </GridView.Resources>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,4,8,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="12" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate                                >
                        <Grid x:ConnectionId='5' Background="Transparent"
                                                                                                     >
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:ConnectionId='6' Text="Remove from Albums"                     >
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE738;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <StackPanel Width="152" Spacing="8" Margin="8">
                                <Border Width="152" Height="152" CornerRadius="6"
                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                    <Image x:ConnectionId='10' Stretch="UniformToFill"
                                                                                                                                           />
                                </Border>
                                <StackPanel>
                                    <TextBlock x:ConnectionId='8'                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:ConnectionId='9'                          TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>

