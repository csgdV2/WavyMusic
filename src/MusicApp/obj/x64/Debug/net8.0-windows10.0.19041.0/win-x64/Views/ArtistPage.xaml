<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="MusicApp.Views.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MusicApp.Core.Models">

    <Grid>
        <TextBlock x:ConnectionId='2' Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 
                                                                                                                       />

        <ProgressRing x:ConnectionId='3' Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False"
                                                                          
                                                                                                                          />

        <ScrollViewer x:ConnectionId='4' Padding="24,16,24,0"
                                                                                                                        >
            <StackPanel Spacing="20" Margin="0,0,0,110">

                <Grid Height="240" CornerRadius="8"
                      Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                    <Image x:ConnectionId='31' Stretch="UniformToFill"
                                                                                                                                                       />

                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0.35" Color="#00000000" />
                                <GradientStop Offset="1" Color="#CC000000" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom" Margin="20,0,20,16" Spacing="10">
                        <TextBlock x:ConnectionId='32'                                                   
                                   Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="2"
                                   Style="{StaticResource TitleLargeTextBlockStyle}" />
                        <TextBlock x:ConnectionId='33'                                                       
                                   Foreground="White" Opacity="0.85" MaxLines="1"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource BodyTextBlockStyle}" />

                        <StackPanel x:ConnectionId='34' Orientation="Horizontal" Spacing="8"
                                                                                                                                                >
                            <Button x:ConnectionId='35'                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xF5B0;" />
                                    <TextBlock Text="Play" />
                                </StackPanel>
                            </Button>
                            <Button x:ConnectionId='36'                      >
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE8B1;" />
                                    <TextBlock Text="Shuffle" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel x:ConnectionId='5' Spacing="8"
                                                                                                                                        >
                    <TextBlock Text="Top songs" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ListView x:ConnectionId='23'                                                    
                              IsItemClickEnabled="True"                            
                              SelectionMode="None" Padding="0"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate                          >
                                <Grid x:ConnectionId='26' Height="56" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                        <Image x:ConnectionId='30' Stretch="UniformToFill"
                                                                                                                                              />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:ConnectionId='28'                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:ConnectionId='29'                              TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBlock x:ConnectionId='27' Grid.Column="2" VerticalAlignment="Center" Opacity="0.6"
                                                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <HyperlinkButton x:ConnectionId='24' Content="Show more"                       
                                     HorizontalAlignment="Left" Margin="0,2,0,0"
                                                                                                                                                />
                </StackPanel>

                <StackPanel x:ConnectionId='6' Spacing="8"
                                                                                                                                        >

                    <TextBlock Text="Releases" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <GridView x:ConnectionId='16'                                                              
                              IsItemClickEnabled="True"                               
                              SelectionMode="None" Padding="0"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <GridView.Resources>
                            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                        </GridView.Resources>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,4,8,12" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="CornerRadius" Value="12" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate                                >
                                <Grid x:ConnectionId='18' Background="Transparent"
                                                                                                             >
                                    <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    <StackPanel Width="152" Spacing="8" Margin="8">
                                        <Border Width="152" Height="152" CornerRadius="6"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                            <Image x:ConnectionId='22' Stretch="UniformToFill"
                                                                                                                                                   />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock x:ConnectionId='20'                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:ConnectionId='21'                          TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <StackPanel x:ConnectionId='7' Spacing="8"
                                                                                                                                          >
                    <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:ConnectionId='15'                                                          
                               TextWrapping="Wrap" Opacity="0.8" MaxWidth="760"
                               Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>

                <StackPanel x:ConnectionId='8' Spacing="8"
                                                                                                                                >
                    <TextBlock Text="Fans might also like" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <GridView x:ConnectionId='9'                                                             
                              IsItemClickEnabled="True"                              
                              SelectionMode="None" Padding="0"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <GridView.Resources>
                            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                        </GridView.Resources>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,4,8,12" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="CornerRadius" Value="12" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate                                 >
                                <Grid x:ConnectionId='11' Background="Transparent"
                                                                                                             >
                                    <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    <StackPanel Width="116" Spacing="8" Margin="8">
                                        <Border Width="116" Height="116" CornerRadius="58"
                                                HorizontalAlignment="Center"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                            <Image x:ConnectionId='14' Stretch="UniformToFill"
                                                                                                                                                   />
                                        </Border>
                                        <TextBlock x:ConnectionId='13'                      TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

