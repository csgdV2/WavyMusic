<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="MusicApp.Views.AlbumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MusicApp.Core.Models">

    <Grid>
        <TextBlock x:ConnectionId='2' Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 
                                                                                                                       />

        <ProgressRing x:ConnectionId='3' Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False"
                                                                          
                                                                                                                          />

        <ScrollViewer x:ConnectionId='4' Padding="24,16,24,0"
                                                                                                                        >
            <StackPanel Spacing="20" Margin="0,0,0,110">

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="200" Height="200" CornerRadius="8"
                            VerticalAlignment="Top"
                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                        <Image x:ConnectionId='20' Stretch="UniformToFill"
                                                                                                                                                            />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                        <TextBlock x:ConnectionId='12'                                                   
                                   TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource TitleLargeTextBlockStyle}" />

                        <HyperlinkButton x:ConnectionId='13' Padding="0" Margin="0,-2,0,0"
                                                             
                                                                                               
                                                                                                                                                 />

                        <TextBlock x:ConnectionId='14'                                                    
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                                                                                                                      />

                        <TextBlock x:ConnectionId='15'                                                      
                                   Opacity="0.7" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}" />

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <Button x:ConnectionId='16'                   
                                    Style="{StaticResource AccentButtonStyle}"
                                                                                                                                             >
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xF5B0;" />
                                    <TextBlock Text="Play" />
                                </StackPanel>
                            </Button>

                            <Button x:ConnectionId='17'                       
                                    ToolTipService.ToolTip="Keep this album in the Albums section">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon x:ConnectionId='18' FontSize="14"                                                       />
                                    <TextBlock x:ConnectionId='19'                                                      />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <ListView x:ConnectionId='5'                                                           
                          IsItemClickEnabled="True"                             
                          SelectionMode="None" Padding="0"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate                          >
                            <Grid x:ConnectionId='7' Height="52" ColumnSpacing="12" Background="Transparent"
                                                                                                       >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:ConnectionId='10'                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:ConnectionId='11'                        TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <TextBlock x:ConnectionId='8' Grid.Column="1" VerticalAlignment="Center" Opacity="0.6"
                                                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                <Button x:ConnectionId='9' x:Name="RowActions" Grid.Column="2"                          Opacity="0"
                                        Width="32" Height="32" Padding="0" CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="More">
                                    <FontIcon Glyph="&#xE712;" FontSize="15" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

