<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MusicApp.Controls.LyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:MusicApp.ViewModels">

    <Grid x:Name="Root" Width="380" RowSpacing="8" Padding="12,12,0,0"
          CornerRadius="12,0,0,0"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderThickness="1,0,0,0"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          Visibility="{x:Bind Player.IsLyricsOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="2" Padding="0,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Lyrics" VerticalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}" />

            <Button Grid.Row="0" Grid.Column="1" Command="{x:Bind Player.ToggleLyricsCommand}"
                    Width="32" Height="32" Padding="0" CornerRadius="6"
                    VerticalAlignment="Top"
                    Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Close">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>

            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="No synced lyrics available" Opacity="0.6"
                       FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{x:Bind ViewModel.ShowUnsyncedNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <ProgressRing Grid.Row="1" Width="28" Height="28"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Grid.Row="1" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260"
                   Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                   Visibility="{x:Bind ViewModel.Message, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />

        <ListView Grid.Row="1" x:Name="LineList"
                  ItemsSource="{x:Bind ViewModel.Lines}"
                  SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="Line_Click"
                  Padding="0,4,12,0"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                  ScrollViewer.IsVerticalScrollChainingEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="4,5,4,5" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LyricsLineItem">
                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap"
                               Margin="9,0,9,0"
                               FontSize="22" LineHeight="30" FontWeight="Bold"
                               SizeChanged="Line_SizeChanged"
                               Opacity="{x:Bind LineOpacity, Mode=OneWay}"
                               Scale="{x:Bind LineScale, Mode=OneWay}">
                        <TextBlock.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.35" />
                        </TextBlock.OpacityTransition>
                        <TextBlock.ScaleTransition>
                            <Vector3Transition Duration="0:0:0.35" />
                        </TextBlock.ScaleTransition>
                    </TextBlock>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Grid.Row="1" x:Name="ResyncButton"
                Click="Resync_Click" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,12,18" Padding="14,7,16,7" CornerRadius="18"
                Style="{StaticResource AccentButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                <TextBlock Text="Back to song" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
