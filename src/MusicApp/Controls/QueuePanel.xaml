<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MusicApp.Controls.QueuePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MusicApp.Core.Models">

    <Grid x:Name="Root" Width="320" RowSpacing="8" Padding="12,12,12,0"
          CornerRadius="12,0,0,0"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderThickness="1,0,0,0"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          Visibility="{x:Bind ViewModel.IsQueueOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Queue" VerticalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}" />

            <Button Grid.Column="1" Command="{x:Bind ViewModel.ToggleAutoplayCommand}"
                    Width="32" Height="32" Padding="0" CornerRadius="6"
                    Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Keep playing similar songs">
                <TextBlock Text="&#x221E;" FontSize="18" FontWeight="SemiBold"
                           Opacity="{x:Bind ViewModel.AutoplayOpacity, Mode=OneWay}"
                           Foreground="{x:Bind ViewModel.AutoplayIsOn, Mode=OneWay, Converter={StaticResource AccentIfOn}}" />
            </Button>

            <Button Grid.Column="2" Command="{x:Bind ViewModel.ClearQueueCommand}"
                    Width="32" Height="32" Padding="0" CornerRadius="6"
                    Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Clear what's next">
                <FontIcon Glyph="&#xE74D;" FontSize="14" />
            </Button>

            <Button Grid.Column="3" Command="{x:Bind ViewModel.ToggleQueueCommand}"
                    Width="32" Height="32" Padding="0" CornerRadius="6"
                    Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Close">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>

        <TextBlock Grid.Row="1" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="220"
                   Text="Nothing lined up yet. Play a song and what comes next shows up here."
                   Visibility="{x:Bind ViewModel.HasQueue, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

        <ListView Grid.Row="1" x:Name="QueueList"
                  ItemsSource="{x:Bind ViewModel.Queue}"
                  SelectedIndex="{x:Bind ViewModel.CurrentIndex, Mode=OneWay}"
                  SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Queue_ItemClick"
                  CanReorderItems="True" CanDragItems="True" AllowDrop="True" ReorderMode="Enabled"
                  Padding="0,0,0,12">
            <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
            </ListView.Resources>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="8,2,8,2" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <Grid Height="52" Background="Transparent"
                          PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                        <Border x:Name="HoverPlate" Opacity="0" CornerRadius="8" Margin="-6,1,-6,1"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                <Image Stretch="UniformToFill"
                                       Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=80}" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind SubtitleText}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>

                            <Button x:Name="RowActions" Grid.Column="0" Click="Remove_Click" Opacity="0"
                                    Width="20" Height="20" Padding="0" CornerRadius="10"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,1,0,0"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="Remove from queue">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground" Color="#D13438" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#8B1A1E" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B1316" />
                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                </Button.Resources>
                                <FontIcon Glyph="&#xE738;" FontSize="11" Foreground="White" />
                            </Button>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
