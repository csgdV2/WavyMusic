<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MusicApp.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicApp.Controls"
    xmlns:models="using:MusicApp.Core.Models">

    <Page.Resources>
        <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
        <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
        <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />

        <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="1" />
        </Style>

        <Style x:Key="TileContainer" TargetType="GridViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="24,16,24,0">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch" Margin="0,0,0,110">

            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}"
                           Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Opacity="0.7" Style="{StaticResource BodyTextBlockStyle}"
                           Text="Everything you've been listening to, and what to play next."
                           Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
            </StackPanel>

            <Border CornerRadius="12" Padding="24" MaxWidth="560" HorizontalAlignment="Left"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Nothing here yet" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="Search for a song to start it playing. What you play collects here, alongside any playlists you make and albums you keep." />
                    <Button Content="Search" Tag="search" Click="SeeAll_Click"
                            HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="10"
                        Visibility="{x:Bind ViewModel.HasRecent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <TextBlock Text="Recently played" Style="{StaticResource SectionHeading}" />
                    <HyperlinkButton Content="See all" Tag="history" Click="SeeAll_Click"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <GridView ItemsSource="{x:Bind ViewModel.Recent, Mode=OneWay}"
                          IsItemClickEnabled="True" SelectionMode="None"
                          ItemClick="Recent_ItemClick"
                          ItemContainerStyle="{StaticResource TileContainer}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <Grid Background="Transparent"
                                  PointerEntered="TrackTile_PointerEntered" PointerExited="TrackTile_PointerExited">
                                <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <StackPanel Width="152" Spacing="8" Margin="8">
                                    <Grid>
                                        <Border Width="152" Height="152" CornerRadius="6"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                            <Image Stretch="UniformToFill"
                                                   Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=304}" />
                                        </Border>

                                        <Button x:Name="RowActions" Click="RowActions_Click" Opacity="0"
                                                Width="32" Height="32" Padding="0" CornerRadius="6"
                                                Margin="0,4,4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="More">
                                            <FontIcon Glyph="&#xE712;" FontSize="15" />
                                        </Button>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <HyperlinkButton Click="Artist_Click" DataContext="{x:Bind}"
                                                         Padding="0" Margin="0" MinWidth="0" MinHeight="0"
                                                         Background="Transparent" BorderThickness="0"
                                                         HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                                         PointerEntered="Artist_PointerEntered"
                                                         PointerExited="Artist_PointerExited">
                                            <TextBlock x:Name="ArtistText" Text="{x:Bind Artist}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </HyperlinkButton>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <StackPanel Spacing="10"
                        Visibility="{x:Bind ViewModel.HasPlaylists, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <TextBlock Text="Your playlists" Style="{StaticResource SectionHeading}" />
                    <HyperlinkButton Content="See all" Tag="playlists" Click="SeeAll_Click"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <GridView ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                          IsItemClickEnabled="True" SelectionMode="None"
                          ItemClick="Playlist_ItemClick"
                          ItemContainerStyle="{StaticResource TileContainer}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:Playlist">
                            <Grid Background="Transparent"
                                  PointerEntered="CollectionTile_PointerEntered" PointerExited="CollectionTile_PointerExited">
                                <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <StackPanel Width="152" Spacing="8" Margin="8">
                                    <Grid>
                                        <controls:PlaylistCover Playlist="{x:Bind}" Size="152" Radius="6" />
                                        <Button x:Name="RowActions" Opacity="0"
                                                Click="PlayPlaylist_Click" DataContext="{x:Bind}"
                                                Width="36" Height="36" Padding="0" CornerRadius="18"
                                                Margin="0,0,8,8"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Style="{StaticResource AccentButtonStyle}"
                                                ToolTipService.ToolTip="Play">
                                            <FontIcon Glyph="&#xF5B0;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <StackPanel Spacing="10"
                        Visibility="{x:Bind ViewModel.HasAlbums, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <TextBlock Text="Albums you kept" Style="{StaticResource SectionHeading}" />
                    <HyperlinkButton Content="See all" Tag="albums" Click="SeeAll_Click"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <GridView ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}"
                          IsItemClickEnabled="True" SelectionMode="None"
                          ItemClick="Album_ItemClick"
                          ItemContainerStyle="{StaticResource TileContainer}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:AlbumResult">
                            <Grid Background="Transparent"
                                  PointerEntered="CollectionTile_PointerEntered" PointerExited="CollectionTile_PointerExited">
                                <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <StackPanel Width="152" Spacing="8" Margin="8">
                                    <Grid>
                                        <Border Width="152" Height="152" CornerRadius="6"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                            <Image Stretch="UniformToFill"
                                                   Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=304}" />
                                        </Border>
                                        <Button x:Name="RowActions" Opacity="0"
                                                Click="PlayAlbum_Click" DataContext="{x:Bind}"
                                                Width="36" Height="36" Padding="0" CornerRadius="18"
                                                Margin="0,0,8,8"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Style="{StaticResource AccentButtonStyle}"
                                                ToolTipService.ToolTip="Play">
                                            <FontIcon Glyph="&#xF5B0;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <StackPanel Spacing="10"
                        Visibility="{x:Bind ViewModel.HasMix, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <TextBlock Text="From your playlists" Style="{StaticResource SectionHeading}" />
                    <HyperlinkButton Content="See all" Tag="playlists" Click="SeeAll_Click"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <GridView ItemsSource="{x:Bind ViewModel.Mix, Mode=OneWay}"
                          IsItemClickEnabled="True" SelectionMode="None"
                          ItemClick="Mix_ItemClick"
                          ItemContainerStyle="{StaticResource TileContainer}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <Grid Background="Transparent"
                                  PointerEntered="TrackTile_PointerEntered" PointerExited="TrackTile_PointerExited">
                                <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <StackPanel Width="152" Spacing="8" Margin="8">
                                    <Grid>
                                        <Border Width="152" Height="152" CornerRadius="6"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                            <Image Stretch="UniformToFill"
                                                   Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=304}" />
                                        </Border>
                                        <Button x:Name="RowActions" Click="RowActions_Click" Opacity="0"
                                                Width="32" Height="32" Padding="0" CornerRadius="6"
                                                Margin="0,4,4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="More">
                                            <FontIcon Glyph="&#xE712;" FontSize="15" />
                                        </Button>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <HyperlinkButton Click="Artist_Click" DataContext="{x:Bind}"
                                                         Padding="0" Margin="0" MinWidth="0" MinHeight="0"
                                                         Background="Transparent" BorderThickness="0"
                                                         HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                                         PointerEntered="Artist_PointerEntered"
                                                         PointerExited="Artist_PointerExited">
                                            <TextBlock x:Name="ArtistText" Text="{x:Bind Artist}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </HyperlinkButton>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <StackPanel Spacing="10"
                        Visibility="{x:Bind ViewModel.ShowSuggestions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.SuggestionsHeading, Mode=OneWay}"
                               Style="{StaticResource SectionHeading}" MaxWidth="520" />
                    <ProgressRing Width="16" Height="16" VerticalAlignment="Center"
                                  IsActive="{x:Bind ViewModel.IsLoadingSuggestions, Mode=OneWay}" />
                </StackPanel>
                <GridView ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}"
                          IsItemClickEnabled="True" SelectionMode="None"
                          ItemClick="Suggestion_ItemClick"
                          ItemContainerStyle="{StaticResource TileContainer}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <Grid Background="Transparent"
                                  PointerEntered="TrackTile_PointerEntered" PointerExited="TrackTile_PointerExited">
                                <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <StackPanel Width="152" Spacing="8" Margin="8">
                                    <Grid>
                                        <Border Width="152" Height="152" CornerRadius="6"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                            <Image Stretch="UniformToFill"
                                                   Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=304}" />
                                        </Border>
                                        <Button x:Name="RowActions" Click="RowActions_Click" Opacity="0"
                                                Width="32" Height="32" Padding="0" CornerRadius="6"
                                                Margin="0,4,4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="More">
                                            <FontIcon Glyph="&#xE712;" FontSize="15" />
                                        </Button>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <HyperlinkButton Click="Artist_Click" DataContext="{x:Bind}"
                                                         Padding="0" Margin="0" MinWidth="0" MinHeight="0"
                                                         Background="Transparent" BorderThickness="0"
                                                         HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                                         PointerEntered="Artist_PointerEntered"
                                                         PointerExited="Artist_PointerExited">
                                            <TextBlock x:Name="ArtistText" Text="{x:Bind Artist}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </HyperlinkButton>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <StackPanel Spacing="10"
                        Visibility="{x:Bind ViewModel.HasTrending, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Bind ViewModel.TrendingHeading, Mode=OneWay}" Style="{StaticResource SectionHeading}" />
                <GridView ItemsSource="{x:Bind ViewModel.Trending, Mode=OneWay}"
                          IsItemClickEnabled="True" SelectionMode="None"
                          ItemClick="Trending_ItemClick"
                          ItemContainerStyle="{StaticResource TileContainer}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <Grid Background="Transparent"
                                  PointerEntered="TrackTile_PointerEntered" PointerExited="TrackTile_PointerExited">
                                <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <StackPanel Width="152" Spacing="8" Margin="8">
                                    <Grid>
                                        <Border Width="152" Height="152" CornerRadius="6"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                            <Image Stretch="UniformToFill"
                                                   Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=304}" />
                                        </Border>
                                        <Button x:Name="RowActions" Click="RowActions_Click" Opacity="0"
                                                Width="32" Height="32" Padding="0" CornerRadius="6"
                                                Margin="0,4,4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="More">
                                            <FontIcon Glyph="&#xE712;" FontSize="15" />
                                        </Button>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <HyperlinkButton Click="Artist_Click" DataContext="{x:Bind}"
                                                         Padding="0" Margin="0" MinWidth="0" MinHeight="0"
                                                         Background="Transparent" BorderThickness="0"
                                                         HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                                         PointerEntered="Artist_PointerEntered"
                                                         PointerExited="Artist_PointerExited">
                                            <TextBlock x:Name="ArtistText" Text="{x:Bind Artist}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </HyperlinkButton>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
            <StackPanel Spacing="10"
                        Visibility="{x:Bind ViewModel.HasFresh, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Bind ViewModel.FreshHeading, Mode=OneWay}" Style="{StaticResource SectionHeading}" />
                <GridView ItemsSource="{x:Bind ViewModel.Fresh, Mode=OneWay}"
                          IsItemClickEnabled="True" SelectionMode="None"
                          ItemClick="Fresh_ItemClick"
                          ItemContainerStyle="{StaticResource TileContainer}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <Grid Background="Transparent"
                                  PointerEntered="TrackTile_PointerEntered" PointerExited="TrackTile_PointerExited">
                                <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <StackPanel Width="152" Spacing="8" Margin="8">
                                    <Grid>
                                        <Border Width="152" Height="152" CornerRadius="6"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                            <Image Stretch="UniformToFill"
                                                   Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=304}" />
                                        </Border>
                                        <Button x:Name="RowActions" Click="RowActions_Click" Opacity="0"
                                                Width="32" Height="32" Padding="0" CornerRadius="6"
                                                Margin="0,4,4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="More">
                                            <FontIcon Glyph="&#xE712;" FontSize="15" />
                                        </Button>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <HyperlinkButton Click="Artist_Click" DataContext="{x:Bind}"
                                                         Padding="0" Margin="0" MinWidth="0" MinHeight="0"
                                                         Background="Transparent" BorderThickness="0"
                                                         HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                                         PointerEntered="Artist_PointerEntered"
                                                         PointerExited="Artist_PointerExited">
                                            <TextBlock x:Name="ArtistText" Text="{x:Bind Artist}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </HyperlinkButton>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
