<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MusicApp.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MusicApp.Core.Models">

    <Grid Padding="24,16,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="PageTitle" Text="Search" VerticalAlignment="Center"
                       Style="{StaticResource TitleTextBlockStyle}" />

            <AutoSuggestBox Grid.Column="1" x:Name="InlineSearch"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="320" Visibility="Collapsed"
                            PlaceholderText="Search"
                            TextChanged="InlineSearch_TextChanged"
                            QuerySubmitted="InlineSearch_QuerySubmitted">
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
        </Grid>

        <SelectorBar Grid.Row="1" x:Name="Filters" SelectionChanged="Filters_SelectionChanged"
                     Visibility="{x:Bind ViewModel.HasQuery, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <SelectorBarItem Text="Songs" Tag="Songs" IsSelected="True" />
            <SelectorBarItem Text="Videos" Tag="Videos" />
            <SelectorBarItem Text="Artists" Tag="Artists" />
            <SelectorBarItem Text="Albums" Tag="Albums" />
            <SelectorBarItem Text="Playlists" Tag="Playlists" />
        </SelectorBar>

        <Grid Grid.Row="2">
            <TextBlock Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.Message, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />

            <ProgressRing Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsHitTestVisible="False"
                          IsActive="{x:Bind ViewModel.ShowBusyIndicator, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.ShowBusyIndicator, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <ListView ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.ShowTracks, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      IsItemClickEnabled="True" ItemClick="Results_ItemClick"
                      SelectionMode="None" Padding="0,0,0,110">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Grid Height="60" ColumnSpacing="12" Background="Transparent"
                              PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="4"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                <Image Stretch="UniformToFill"
                                       Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=88}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind SubtitleText}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.6"
                                       Text="{x:Bind DurationText}" Style="{StaticResource CaptionTextBlockStyle}" />
                            <Button x:Name="RowActions" Grid.Column="3" Click="RowActions_Click" Opacity="0"
                                    Width="32" Height="32" Padding="0" CornerRadius="6"
                                    VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="More">
                                <FontIcon Glyph="&#xE712;" FontSize="15" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <GridView ItemsSource="{x:Bind ViewModel.Artists, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.ShowArtists, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      IsItemClickEnabled="True" ItemClick="Artists_ItemClick"
                      SelectionMode="None" Padding="0,0,0,110">
                <GridView.Resources>
                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                </GridView.Resources>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,4,8,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="12" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:ArtistResult">
                        <Grid Background="Transparent"
                              PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
                            <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <StackPanel Width="116" Spacing="8" Margin="8">
                                <Border Width="116" Height="116" CornerRadius="58"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                    <Image Stretch="UniformToFill"
                                           Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=232}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Subtitle}" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <GridView ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.ShowAlbums, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      IsItemClickEnabled="True" ItemClick="Albums_ItemClick"
                      SelectionMode="None" Padding="0,0,0,110">
                <GridView.Resources>
                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                </GridView.Resources>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,4,8,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="12" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:AlbumResult">
                        <Grid Background="Transparent"
                              PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
                            <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <StackPanel Width="152" Spacing="8" Margin="8">
                                <Border Width="152" Height="152" CornerRadius="6"
                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                    <Image Stretch="UniformToFill"
                                           Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=304}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <GridView ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.ShowPlaylists, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      IsItemClickEnabled="True" ItemClick="Playlists_ItemClick"
                      SelectionMode="None" Padding="0,0,0,110">
                <GridView.Resources>
                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                </GridView.Resources>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,4,8,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="12" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlaylistResult">
                        <Grid Background="Transparent"
                              PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
                            <Border x:Name="HoverPlate" Opacity="0" CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <StackPanel Width="152" Spacing="8" Margin="8">
                                <Border Width="152" Height="152" CornerRadius="6"
                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                    <Image Stretch="UniformToFill"
                                           Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=304}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
