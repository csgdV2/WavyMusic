<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MusicApp.Views.AlbumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MusicApp.Core.Models">

    <Grid>
        <TextBlock Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                   Visibility="{x:Bind ViewModel.Message, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />

        <ProgressRing Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer Padding="24,16,24,0"
                      Visibility="{x:Bind ViewModel.IsLoaded, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Spacing="20" Margin="0,0,0,110">

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="200" Height="200" CornerRadius="8"
                            VerticalAlignment="Top"
                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                        <Image Stretch="UniformToFill"
                               Source="{x:Bind ViewModel.Album.ThumbnailUrl, Mode=OneWay, Converter={StaticResource DecodedImage}, ConverterParameter=400}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.Album.Title, Mode=OneWay}"
                                   TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource TitleLargeTextBlockStyle}" />

                        <HyperlinkButton Padding="0" Margin="0,-2,0,0"
                                         Click="Artist_Click"
                                         Content="{x:Bind ViewModel.Album.Artist, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.CanOpenArtist, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{x:Bind ViewModel.Album.Artist, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Visibility="{x:Bind ViewModel.CanOpenArtist, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                        <TextBlock Text="{x:Bind ViewModel.Album.Subtitle, Mode=OneWay}"
                                   Opacity="0.7" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}" />

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <Button Click="Play_Click"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind ViewModel.Album.HasTracks, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xF5B0;" />
                                    <TextBlock Text="Play" />
                                </StackPanel>
                            </Button>

                            <Button Click="Favorite_Click"
                                    ToolTipService.ToolTip="Keep this album in the Albums section">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.FavoriteGlyph, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.FavoriteLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <ListView ItemsSource="{x:Bind ViewModel.Album.Tracks, Mode=OneWay}"
                          IsItemClickEnabled="True" ItemClick="Tracks_ItemClick"
                          SelectionMode="None" Padding="0"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <Grid Height="52" ColumnSpacing="12" Background="Transparent"
                                  PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Artist}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.6"
                                           Text="{x:Bind DurationText}" Style="{StaticResource CaptionTextBlockStyle}" />
                                <Button x:Name="RowActions" Grid.Column="2" Click="RowActions_Click" Opacity="0"
                                        Width="32" Height="32" Padding="0" CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="More">
                                    <FontIcon Glyph="&#xE712;" FontSize="15" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
