<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MusicApp.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicApp.Controls"
    xmlns:models="using:MusicApp.Core.Models">

    <Grid Padding="24,16,24,0" ColumnSpacing="20" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <TextBlock Text="Playlists" Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="32" Height="32" Padding="0" CornerRadius="6"
                    ToolTipService.ToolTip="Add a playlist">
                <FontIcon Glyph="&#xE710;" FontSize="14" />
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="New playlist…" Click="New_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Import from YouTube Music…" Click="Import_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Import from Spotify…" Click="ImportSpotify_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE93E;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0">
            <ListView x:Name="PlaylistList"
                      ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                      SelectionMode="Single"
                      CanReorderItems="True" AllowDrop="True" ReorderMode="Enabled">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Playlist">
                        <Grid Height="56" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:PlaylistCover Grid.Column="0" Playlist="{x:Bind}" Size="40" Radius="4" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="8"
              Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <controls:PlaylistCover Playlist="{x:Bind ViewModel.Selected, Mode=OneWay}" Size="56" Radius="6" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" MaxLines="1"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedSummary, Mode=OneWay}" Opacity="0.7"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.PlaySelectedCommand}" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xF5B0;" FontSize="13" />
                        <TextBlock Text="Play" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ShuffleSelectedCommand}" ToolTipService.ToolTip="Shuffle">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B1;" FontSize="13" />
                        <TextBlock Text="Shuffle" />
                    </StackPanel>
                </Button>
                <Button Content="Rename" Click="Rename_Click" />
                <Button Content="Delete" Click="Delete_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <TextBlock Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                       Text="This playlist is empty. Play something, then add it from the ⋯ menu on the now-playing bar."
                       Visibility="{x:Bind ViewModel.SelectedIsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <ListView x:Name="TrackList"
                      ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                      IsItemClickEnabled="True" ItemClick="Tracks_ItemClick"
                      SelectionMode="None" Padding="0,0,0,110"
                      CanReorderItems="True" AllowDrop="True" ReorderMode="Enabled">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Grid Height="60" ColumnSpacing="12" Background="Transparent"
                              PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Remove from playlist" Click="RemoveTrack_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE738;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="4"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                <Image Stretch="UniformToFill"
                                       Source="{x:Bind ThumbnailUrl, Converter={StaticResource DecodedImage}, ConverterParameter=88}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind SubtitleText}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.6"
                                       Text="{x:Bind DurationText}" Style="{StaticResource CaptionTextBlockStyle}" />
                            <Button x:Name="RowActions" Grid.Column="3" Click="RowActions_Click" Opacity="0"
                                    Width="32" Height="32" Padding="0" CornerRadius="6"
                                    VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="More">
                                <FontIcon Glyph="&#xE712;" FontSize="15" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
